# ============================================================
# knowUrDB (m.DB) — Dedicated Environment Configuration
# ============================================================

# Dedicated KnowUrDB MongoDB Instance (Isolated from localhost:27017)
MONGODB_URI=mongodb://localhost:27018
MONGODB_CONTROL_DB=knowurdb
MONGODB_DATABASE=knowurdb
MONGODB_MAX_POOL_SIZE=50
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000

# Set to true ONLY if explicitly overriding the port 27017 isolation safety guard
ALLOW_SHARED_MONGODB_27017=false

# AI / LLM Configuration (Optional - Deterministic Engine + Gemini Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend / Frontend Server Settings
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Dataset Persistence Directory
DEMO_DATASET_ROOT=demo_datasets
